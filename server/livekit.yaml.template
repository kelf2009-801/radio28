# LiveKit server config — fill in <...> from .env
port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
  enable_loopback_candidate: false
keys:
  <LK_API_KEY>: <LK_API_SECRET>
turn:
  enabled: true
  domain: <SERVER_IP>
  tls_port: 5349
  udp_port: 3478
  external_tls: false
logging:
  level: info
