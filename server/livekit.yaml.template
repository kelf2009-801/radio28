# LiveKit server config — fill in <...> from .env
port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  # UDP mux: all media over ONE port — friendlier to NAT / DDoS filters.
  # NOTE: do NOT also set port_range_start/end, or mux is ignored.
  udp_port: 7882
  # Pin the advertised IP: with use_external_ip: true LiveKit also advertises
  # docker bridge IPs (172.x) and clients get confused / drop the session.
  use_external_ip: false
  node_ip: <SERVER_IP>
  enable_loopback_candidate: false
  stun_servers:
    - stun.l.google.com:19302
  # External coturn (see turnserver.conf). The embedded `turn:` block needs a
  # TLS cert and crashes without one — do not use it.
  turn_servers:
    - host: <SERVER_IP>
      port: 3478
      protocol: udp
      secret: <TURN_SECRET>
keys:
  <LK_API_KEY>: <LK_API_SECRET>
logging:
  level: info
